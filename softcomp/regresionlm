x1_range = linspace(x.min(), x.max(), 1000)
x2_range = linspace(y.min(), y.max(), 1000)
x1, x2 = meshgrid(x1_range, x2_range)

z = modeloregr.predict(c_[x1.ravel(), x2.ravel()]).reshape(x1.shape)

ax.plot_surface(x1, x2, z, color='red', alpha=0.3, rstride=400, cstride=100)

ax.set_xlabel('Taza de ocupación')
